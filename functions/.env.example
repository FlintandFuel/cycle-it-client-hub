# Copy to .env (or .env.cycle-it-client-hub for prod-only values) and fill
# in real values. Never commit the filled-in file — it's git-ignored.

# Gmail API — OAuth2 against Ruan's Google Workspace account (not a service
# account; Gmail send requires a real mailbox). Create OAuth client
# credentials in Google Cloud Console for project cycle-it-client-hub,
# then generate a refresh token for the scope
# https://www.googleapis.com/auth/gmail.send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Hosting URL emails link back to. Defaults to the Firebase-issued
# https://cycle-it-client-hub.web.app if unset — override once a custom
# domain (e.g. fit.cycleit.co.za) is wired up.
SITE_URL=

# Phase 2b — Ruan's Google review shortcut, from the build brief.
REVIEW_URL=https://g.page/r/CYrj4CFQ_xiSEB0/review

# Phase 3 — 3-month follow-up booking link.
CALENDLY_URL=https://calendly.com/ruan-photos26/
