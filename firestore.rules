rules_version = '2';

// Profile IDs are random/unguessable and act as the access control for
// single-document reads (like an unlisted link) — no auth needed for
// `get`. Listing the whole collection (the /clients dashboard) requires
// a signed-in Google account, gated client-side by AuthGate and enforced
// here too. The fitter form (/new) still writes without auth, matching
// its low-friction "standing next to a bike" use case — tighten `create`
// to `request.auth != null` if that changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{profileId} {
      allow get: if true;
      allow list: if request.auth != null;

      allow create: if request.resource.data.client.consentGiven == true;

      allow update: if false;
      allow delete: if false;
    }
  }
}
