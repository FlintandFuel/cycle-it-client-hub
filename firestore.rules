rules_version = '2';

// Profile IDs are random/unguessable and act as the access control for
// single-document reads (like an unlisted link) — no auth needed for
// `get`. Listing the whole collection (the /clients dashboard) requires
// a signed-in Google account on the allowlist below — mirrors
// src/components/AuthGate.jsx, keep the two in sync. The fitter form
// (/new) still writes without auth, matching its low-friction "standing
// next to a bike" use case — tighten `create` to `request.auth != null`
// if that changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{profileId} {
      allow get: if true;
      allow list: if request.auth != null &&
        request.auth.token.email in ['ruan.photos26@gmail.com', 'cvaniek@gmail.com'];

      allow create: if request.resource.data.client.consentGiven == true;

      // Edit/delete from the fitter dashboard — same allowlist as `list`.
      allow update: if request.auth != null &&
        request.auth.token.email in ['ruan.photos26@gmail.com', 'cvaniek@gmail.com'];
      allow delete: if request.auth != null &&
        request.auth.token.email in ['ruan.photos26@gmail.com', 'cvaniek@gmail.com'];
    }

    // Calendly's booking-confirmation redirect lands an unauthenticated
    // client browser on /booked, which writes one of these — so `create`
    // has to stay open the same way profile `create` does. Unlike
    // profiles, nothing about a booking is meant to be individually
    // link-shareable, so `get` stays closed; only the allowlisted fitter
    // dashboard can read them at all, to view the day's list.
    match /bookings/{bookingId} {
      allow get: if false;
      allow list: if request.auth != null &&
        request.auth.token.email in ['ruan.photos26@gmail.com', 'cvaniek@gmail.com'];

      allow create: if request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0;

      allow update: if false;
      allow delete: if false;
    }

    // Monthly Dunkeld Cycles billing invoices — generated and emailed by
    // functions/index.js (Cloud Functions run as admin and bypass these
    // rules entirely; this just documents/blocks any client-side attempt).
    // `get` stays open the same way a profile's does, so the "View online"
    // link in the invoice email works with no sign-in.
    match /invoices/{invoiceId} {
      allow get: if true;
      allow list: if request.auth != null &&
        request.auth.token.email in ['ruan.photos26@gmail.com', 'cvaniek@gmail.com'];

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
